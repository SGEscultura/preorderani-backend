generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- lookup tables ----------

model roles {
  role_id   Int     @id @default(autoincrement())
  role_name String  @unique @db.VarChar(50)
  users     users[]
}

model units {
  unit_id    Int        @id @default(autoincrement())
  unit_code  String     @unique @db.VarChar(20)
  unit_label String     @db.VarChar(50)
  crops      crops[]
  harvests   harvests[]
}

model crops {
  crop_id         Int        @id @default(autoincrement())
  crop_name       String     @unique @db.VarChar(100)
  default_unit_id Int
  default_unit    units      @relation(fields: [default_unit_id], references: [unit_id])
  harvests        harvests[]
}

model harvest_statuses {
  harvest_status_id   Int        @id @default(autoincrement())
  harvest_status_name String     @unique @db.VarChar(30)
  harvests            harvests[]
}

model pre_order_statuses {
  pre_order_status_id   Int          @id @default(autoincrement())
  pre_order_status_name String       @unique @db.VarChar(30)
  pre_orders            pre_orders[]
}

model payment_methods {
  payment_method_id   Int            @id @default(autoincrement())
  payment_method_name String         @unique @db.VarChar(30)
  payments            payments[]
  payment_logs        payment_logs[]
}

model payment_statuses {
  payment_status_id   Int            @id @default(autoincrement())
  payment_status_name String         @unique @db.VarChar(30)
  payments            payments[]
  payment_logs        payment_logs[]
}

// ---------- main tables ----------

model users {
  user_id       Int            @id @default(autoincrement())
  role_id       Int
  user_name     String         @db.VarChar(150)
  user_email    String         @unique @db.VarChar(150)
  user_password String         @db.VarChar(255)
  user_phone    String?        @db.VarChar(20)
  user_location String?        @db.VarChar(150)
  created_at    DateTime       @default(now()) @db.Timestamp(6)
  role          roles          @relation(fields: [role_id], references: [role_id])
  harvests      harvests[]     @relation("HarvestFarmer")
  pre_orders    pre_orders[]   @relation("PreOrderConsumer")
  payment_logs  payment_logs[] @relation("PaymentLogChangedBy")
}

model harvests {
  harvest_id             Int              @id @default(autoincrement())
  farmer_id              Int
  crop_id                Int
  unit_id                Int
  harvest_status_id      Int
  harvest_quantity       Decimal          @db.Decimal(10, 2)
  harvest_price_per_unit Decimal          @db.Decimal(10, 2)
  harvest_date           DateTime         @db.Date
  harvest_location       String           @db.VarChar(150)
  harvest_description    String?          @db.Text
  created_at             DateTime         @default(now()) @db.Timestamp(6)
  farmer                 users            @relation("HarvestFarmer", fields: [farmer_id], references: [user_id])
  crop                   crops            @relation(fields: [crop_id], references: [crop_id])
  unit                   units            @relation(fields: [unit_id], references: [unit_id])
  harvest_status         harvest_statuses @relation(fields: [harvest_status_id], references: [harvest_status_id])
  pre_orders             pre_orders[]
}

model pre_orders {
  pre_order_id        Int                @id @default(autoincrement())
  harvest_id          Int
  consumer_id         Int
  pre_order_status_id Int
  pre_order_quantity  Decimal            @db.Decimal(10, 2)
  created_at          DateTime           @default(now()) @db.Timestamp(6)
  harvest             harvests           @relation(fields: [harvest_id], references: [harvest_id])
  consumer            users              @relation("PreOrderConsumer", fields: [consumer_id], references: [user_id])
  pre_order_status    pre_order_statuses @relation(fields: [pre_order_status_id], references: [pre_order_status_id])
  payment             payments?
}

model payments {
  payment_id        Int              @id @default(autoincrement())
  pre_order_id      Int              @unique
  payment_method_id Int
  payment_status_id Int
  payment_amount    Decimal          @db.Decimal(10, 2)
  payment_reference String?          @db.VarChar(100)
  paid_at           DateTime?        @db.Timestamp(6)
  created_at        DateTime         @default(now()) @db.Timestamp(6)
  pre_order         pre_orders       @relation(fields: [pre_order_id], references: [pre_order_id])
  payment_method    payment_methods  @relation(fields: [payment_method_id], references: [payment_method_id])
  payment_status    payment_statuses @relation(fields: [payment_status_id], references: [payment_status_id])
  invoice           invoices?
  payment_logs      payment_logs[]
}

model invoices {
  invoice_id     Int      @id @default(autoincrement())
  payment_id     Int      @unique
  invoice_number String   @unique @db.VarChar(30)
  issued_at      DateTime @default(now()) @db.Timestamp(6)
  payment        payments @relation(fields: [payment_id], references: [payment_id])
}

model payment_logs {
  payment_log_id    Int              @id @default(autoincrement())
  payment_id        Int
  payment_method_id Int
  payment_status_id Int
  changed_by        Int
  log_note          String?          @db.VarChar(255)
  logged_at         DateTime         @default(now()) @db.Timestamp(6)
  payment           payments         @relation(fields: [payment_id], references: [payment_id])
  payment_method    payment_methods  @relation(fields: [payment_method_id], references: [payment_method_id])
  payment_status    payment_statuses @relation(fields: [payment_status_id], references: [payment_status_id])
  changed_by_user   users            @relation("PaymentLogChangedBy", fields: [changed_by], references: [user_id])
}
